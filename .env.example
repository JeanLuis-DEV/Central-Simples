NEXT_PUBLIC_FINORYA_URL=http://127.0.0.1:5180
NEXT_PUBLIC_AJUDANTE_URL=http://127.0.0.1:5173
NEXT_PUBLIC_LINGUA_MEMORY_URL=http://127.0.0.1:5200

# Set true in Cloudflare Pages and publish out/.
CENTRAL_STATIC_EXPORT=false

# The Worker API uses a separate Central administrator and signed connections
# to the application APIs. Keep these values in .dev.vars / Wrangler secrets.
# Generate the password hash with: node scripts/hash-central-password.mjs "..."
# CENTRAL_ADMIN_USERNAME=admin
# CENTRAL_ADMIN_PASSWORD_HASH=pbkdf2$sha256$210000$...
# CENTRAL_SESSION_SECRET=generate-a-random-32-byte-secret
# CENTRAL_INTEGRATION_SECRET=the-same-secret-in-Ajudante-and-Finorya
# Production build:
# NEXT_PUBLIC_FINORYA_URL=https://finorya.centralsimples.com.br
# NEXT_PUBLIC_AJUDANTE_URL=https://ajudante.centralsimples.com.br
# NEXT_PUBLIC_LINGUA_MEMORY_URL=https://lingua-memory.centralsimples.com.br
